{
  "name": "@forest/records",
  "version": "0.0.0",
  "private": true,
  "description": "Forest records: signed records on open hosts. The core library, a reference host, private records, a fetch that reaches only public addresses, the record schemas, tests and vectors. Nothing is shipped.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/records/src/index.d.ts",
      "default": "./dist/records/src/index.js"
    },
    "./host": {
      "types": "./dist/records/src/host.d.ts",
      "default": "./dist/records/src/host.js"
    },
    "./private": {
      "types": "./dist/records/src/private.d.ts",
      "default": "./dist/records/src/private.js"
    },
    "./public": {
      "types": "./dist/records/src/public.d.ts",
      "default": "./dist/records/src/public.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --test-force-exit test/*.test.ts",
    "bench": "node bench/throughput.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "age-encryption": "0.3.1",
    "canonicalize": "5.1.0",
    "poseidon-lite": "0.3.0",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@zk-kit/baby-jubjub": "1.0.3",
    "@zk-kit/eddsa-poseidon": "1.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
