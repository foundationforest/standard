{
  "name": "@forest/person-circuit",
  "version": "0.0.0",
  "private": true,
  "description": "The person proof: a note signed by an issuer for the person's note number, a stamp for one label, for one main key, naming neither the note nor the person. The circuit, its devnet setup, and its tests through the registry client.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fetch": "node scripts/fetch.ts",
    "compile": "node scripts/compile.ts",
    "vk": "node scripts/parse_vk_to_rust.cjs devnet/verification-key.json ../program/src",
    "check": "tsc --noEmit",
    "test": "node --test --test-force-exit test/person.test.ts"
  },
  "dependencies": {
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@zk-kit/eddsa-poseidon": "1.0.4",
    "circomlib": "2.0.5",
    "ffjavascript": "0.3.1",
    "poseidon-lite": "0.3.0",
    "typescript": "5.9.3"
  }
}
