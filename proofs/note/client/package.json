{
  "name": "@foundationforest/note",
  "version": "0.0.0",
  "private": true,
  "description": "The note proof's client: the note an issuer signs, the note proof a device makes from it for one profile, and the check any reader makes.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-force-exit test/client.test.ts test/note.test.ts test/no-buffer.test.ts"
  },
  "dependencies": {
    "@foundationforest/keys": "0.0.0",
    "@zk-kit/eddsa-poseidon": "1.0.4",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0"
  }
}
